load("@build_bazel_rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

swift_binary(
    name = "App",
    srcs = ["main.swift"],
    deps = [
        "//Features/Animals:AnimalsGraphQL",
        "//Features/Pets:PetsGraphQL",
        "//graphql:AnimalKingdomAPI",
    ],
)

sh_test(
    name = "app_test",
    srcs = ["app_test.sh"],
    args = ["$(rootpath :App)"],
    data = [":App"],
)
