load("@build_bazel_rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")

# One reused simulator for every test bundle. The default runner creates and
# boots a fresh simulator per bundle, which on a cold CI machine can take
# minutes each.
ios_xctestrun_runner(
    name = "ios_test_runner",
    reuse_simulator = True,
    visibility = ["//visibility:public"],
)
