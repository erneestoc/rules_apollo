load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_apollo//apollo:swift.bzl", "apollo_swift_operations", "apollo_swift_test_mocks")

filegroup(
    name = "graphql",
    srcs = glob(["*.graphql"]),
    visibility = ["//graphql:__pkg__"],
)

# Swift module with only the generated operations and fragments.
apollo_swift_operations(
    name = "CharactersGraphQL",
    srcs = [":graphql"],
    apollo_api = "@apollo_ios//:ApolloAPI",
    schema = "//graphql:RickAndMortyAPI",
    visibility = ["//visibility:public"],
)

# The feature: SwiftUI screens and view models.
swift_library(
    name = "CharactersFeature",
    srcs = glob(["Sources/*.swift"]),
    module_name = "CharactersFeature",
    visibility = ["//visibility:public"],
    deps = [
        ":CharactersGraphQL",
        "//Networking",
    ],
)

# Mocks only this feature's operations reference.
apollo_swift_test_mocks(
    name = "CharactersTestSupport",
    apollo_api = "@apollo_ios//:ApolloAPI",
    apollo_test_support = "@apollo_ios//:ApolloTestSupport",
    base = "//graphql:RickAndMortyAPIMocks",
    operations = [":CharactersGraphQL"],
    schema = "//graphql:RickAndMortyAPI",
    visibility = ["//visibility:public"],
)

swift_library(
    name = "CharactersTestsLib",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    module_name = "CharactersTests",
    deps = [
        ":CharactersFeature",
        ":CharactersGraphQL",
        ":CharactersTestSupport",
        "//graphql:RickAndMortyAPIMocks",
        "@apollo_ios//:ApolloTestSupport",
    ],
)

ios_unit_test(
    name = "CharactersTests",
    minimum_os_version = "18.0",
    visibility = ["//visibility:public"],
    deps = [":CharactersTestsLib"],
)
