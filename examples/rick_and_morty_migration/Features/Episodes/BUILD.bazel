load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_apollo//apollo:defs.bzl", "apollo_operations")
load("@rules_apollo//apollo:swift.bzl", "apollo_runtime", "apollo_runtime_copts", "apollo_swift_library")

filegroup(
    name = "graphql",
    srcs = glob(["*.graphql"]),
    visibility = ["//graphql:__pkg__"],
)

# This package uses the rules directly instead of apollo_swift_operations: the
# codegen target's output (plain .swift files) goes into a swift_library of our
# own. Characters and Locations use the macros; both styles mix in one app.
#
# Episodes' generated code only exists on the 2.4.0 runtime, so its module keeps
# its plain name and needs no alias. Only what really exists on both runtimes
# (Apollo iOS, the schema module, CharactersGraphQL) is suffixed and aliased.
NEXT = apollo_runtime("next")

apollo_operations(
    name = "EpisodesGraphQL_codegen",
    srcs = [":graphql"],
    module_name = "EpisodesGraphQL",
    schema = "//graphql:RickAndMortyAPI_v2_apollo",
    # Spreads CharacterCard: the 2.4.0 variant of the Characters fragments.
    deps = ["//Features/Characters:CharactersGraphQL_v2_apollo"],
)

swift_library(
    name = "EpisodesGraphQL",
    srcs = [":EpisodesGraphQL_codegen"],
    # Generated code says `import ApolloAPI` and `RickAndMortyAPI.Objects...`.
    copts = apollo_runtime_copts(
        "next",
        modules = ["RickAndMortyAPI"],
    ),
    module_name = "EpisodesGraphQL",
    visibility = ["//visibility:public"],
    deps = [
        "//Features/Characters:CharactersGraphQL_v2",
        "//graphql:RickAndMortyAPI_v2",
        NEXT.apollo_api,
    ],
)

# The feature, on the "next" runtime (Apollo iOS 2.4.0).
apollo_swift_library(
    name = "EpisodesFeature",
    srcs = glob(["Sources/*.swift"]),
    runtime = "next",
    visibility = ["//visibility:public"],
    runtime_deps = ["//Networking"],
    deps = [
        ":EpisodesGraphQL",
        "//Features/CharacterUI",
    ],
)

apollo_swift_library(
    name = "EpisodesTestsLib",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    apollo_deps = [
        "ApolloAPI",
        "ApolloTestSupport",
    ],
    module_name = "EpisodesTests",
    runtime = "next",
    runtime_deps = ["//graphql:RickAndMortyAPIMocks"],
    deps = [
        ":EpisodesFeature",
        ":EpisodesGraphQL",
    ],
)

ios_unit_test(
    name = "EpisodesTests",
    minimum_os_version = "18.0",
    runner = "//tools:ios_test_runner",
    visibility = ["//visibility:public"],
    deps = [":EpisodesTestsLib"],
)
