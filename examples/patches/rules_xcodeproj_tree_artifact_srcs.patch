rules_xcodeproj 4.1.0 reuses the SwiftCompile action's Args, which expand tree
artifacts in srcs (rules_apollo's generated sources), in actions that do not
have the directories as inputs. This declares them as inputs where the Args
are reused, and lists the directories themselves in the generated filelists.

diff --git a/xcodeproj/internal/compiler_args.bzl b/xcodeproj/internal/compiler_args.bzl
--- a/xcodeproj/internal/compiler_args.bzl
+++ b/xcodeproj/internal/compiler_args.bzl
@@ -67,9 +67,18 @@ def _collect_compiler_args(
             target.
     """
     swift_args = EMPTY_LIST
+    swift_directories = EMPTY_LIST
     for action in target.actions:
         if action.mnemonic == "SwiftCompile":
             swift_args = action.args
+
+            # `action.args` expand tree artifacts (e.g. generated sources), so
+            # any action that reuses them needs the directories as inputs.
+            swift_directories = tuple([
+                file
+                for file in action.inputs.to_list()
+                if file.is_directory and not file.is_source
+            ])
             break
 
     conly_args, cxx_args = _get_unprocessed_cc_compiler_opts(
@@ -82,6 +91,7 @@ def _collect_compiler_args(
         conly = conly_args,
         cxx = cxx_args,
         swift = swift_args,
+        swift_directories = swift_directories,
     )
 
 compiler_args = struct(
