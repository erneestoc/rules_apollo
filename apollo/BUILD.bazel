load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//apollo/private:rules"],
)

bzl_library(
    name = "swift",
    srcs = ["swift.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":defs",
        "@build_bazel_rules_swift//swift",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//apollo/private:rules"],
)
